[Unit]
Description=AllStar Herald - Enhanced Tail Message & Announcement Daemon
Documentation=https://github.com/N6LKA/AllStar-Herald
After=network.target asterisk.service
Wants=asterisk.service

[Service]
Type=simple
ExecStart=/etc/asterisk/scripts/herald/herald.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=herald

# Reduce unnecessary restarts during Asterisk maintenance
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
